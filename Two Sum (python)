class Solution(object):
    def twoSum(self, nums, target):
        """
        :type nums: List[int]
        :type target: int
        :rtype: List[int]
        """
        #Time complexity: O(n)
        comps = {}
        for i, x in enumerate(nums):
            comp = target - x
            if comp in comps:
                return [comps[comp],i]
            else:
                comps[x] = i        
